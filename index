  <style>
    :root {
      --verde-azulado: #3C7A6F;
      --verde-profundo: #2F4D47;
      --verde-claro: #DCEAE6;
      --terracota-oscuro: #9A5A24;
      --terracota: #C98A4B;
      --crema: #F4F2EC;
      --tinta: #2A2A2A;
      --gris: #5E5E5E;
      --blanco: #FFFFFF;
      --fuente-serif: Georgia, "Times New Roman", serif;
      --fuente-sans: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--fuente-serif);
      color: var(--tinta);
      background-color: var(--blanco);
      line-height: 1.65;
      font-size: 16px;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--verde-azulado);
      transition: color 0.15s ease-in-out;
    }

    a:focus-visible, input:focus-visible {
      outline: 3px solid var(--terracota-oscuro);
      outline-offset: 2px;
    }

    .cabecera {
      background-color: var(--verde-profundo);
      color: var(--blanco);
      border-bottom: 6px solid var(--terracota);
      padding: 3rem 1.25rem 2.5rem;
    }

    .envoltura {
      max-width: 760px;
      margin: 0 auto;
    }

    .cabecera .grupo {
      font-family: var(--fuente-sans);
      font-size: 0.95rem;
      color: var(--verde-claro);
      margin-bottom: 0.5rem;
    }

    .cabecera h1 {
      font-weight: normal;
      font-size: clamp(2.2rem, 6vw, 3.2rem);
      line-height: 1.1;
      margin-bottom: 1rem;
    }

    .cabecera .presentacion {
      max-width: 38em;
      color: #EAF1EF;
      font-size: 1.05rem;
    }

    main {
      padding: 2.5rem 1.25rem 3rem;
    }

    .buscador label {
      display: block;
      font-family: var(--fuente-sans);
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--verde-profundo);
      margin-bottom: 0.4rem;
    }

    .buscador input {
      width: 100%;
      padding: 0.8rem 1rem;
      font-family: var(--fuente-sans);
      font-size: 1rem;
      color: var(--tinta);
      border: 1px solid #B9C9C4;
      border-radius: 4px;
      background: var(--blanco);
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .buscador input:focus {
      border-color: var(--verde-azulado);
      box-shadow: 0 0 0 3px rgba(60, 122, 111, 0.2);
    }

    .sin-resultados {
      display: none;
      margin-top: 1.5rem;
      font-family: var(--fuente-sans);
      color: var(--gris);
      font-style: italic;
    }

    .lista {
      list-style: none;
      margin-top: 2rem;
    }

    .boletin {
      background-color: var(--crema);
      border-left: 5px solid var(--verde-azulado);
      padding: 1.5rem 1.5rem 1.6rem;
      margin-bottom: 1.25rem;
      border-radius: 0 4px 4px 0;
    }

    .boletin .numero {
      font-family: var(--fuente-sans);
      font-size: 0.9rem;
      font-weight: bold;
      color: var(--terracota-oscuro);
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .boletin h2 {
      font-weight: normal;
      font-size: 1.4rem;
      line-height: 1.3;
      color: var(--verde-profundo);
      margin: 0.3rem 0 0.6rem;
    }

    .boletin h2 a {
      color: inherit;
      text-decoration: none;
    }

    .boletin h2 a:hover {
      text-decoration: underline;
    }

    .boletin .resumen {
      text-align: justify;
      hyphens: auto;
    }

    .boletin .boton {
      display: inline-block;
      margin-top: 1rem;
      padding: 0.7rem 1.2rem;
      min-height: 44px;
      line-height: 1.4;
      font-family: var(--fuente-sans);
      font-size: 0.95rem;
      font-weight: 500;
      color: var(--blanco);
      background-color: var(--verde-azulado);
      text-decoration: none;
      border-radius: 4px;
      transition: background-color 0.15s ease-in-out;
    }

    .boletin .boton:hover {
      background-color: var(--verde-profundo);
      text-decoration: none;
    }

    footer {
      background-color: var(--crema);
      border-top: 1px solid #DDD8CC;
      padding: 2.5rem 1.25rem;
      font-family: var(--fuente-sans);
      font-size: 0.92rem;
      color: var(--tinta);
    }

    footer p {
      margin-bottom: 0.6rem;
    }

    footer .redes {
      list-style: none;
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem 1.2rem;
      margin-top: 0.8rem;
    }

    footer a {
      color: var(--verde-profundo);
      text-decoration: none;
    }

    footer a:hover {
      text-decoration: underline;
    }
  </style>
